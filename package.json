{
  "name": "note-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start": "node scripts/build.mts --watch",
    "build": "npm run typecheck && node scripts/build.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:architecture": "vitest run --config vitest.build.config.mts scripts/__tests__/architecture.test.mts",
    "test:lint": "vitest run --config vitest.build.config.mts scripts/__tests__/architecture.test.mts scripts/__tests__/lint-rules.test.mts",
    "test:build": "npm run build && vitest run --config vitest.build.config.mts",
    "test:extension": "npm run test:build && playwright test && npm run test:browser",
    "test:browser": "vitest run --config vitest.browser.config.mts",
    "test:firefox": "npm run test:browser -- -t Firefox",
    "coverage": "vitest run --coverage",
    "update:deps": "npx npm-check-updates --interactive --format group",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "npm run lint -- --fix",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:lint",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,js,cjs,mjs}": [
      "oxlint --deny-warnings --report-unused-disable-directives --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,yml,yaml,css,svg}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "overrides": {
    "@rolldown/plugin-babel": {
      "@babel/plugin-transform-runtime": "^7.29.0"
    },
    "@types/html-to-pdfmake": {
      "@types/pdfmake": "$@types/pdfmake"
    }
  },
  "dependencies": {
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "clsx": "2.1.1",
    "html-to-pdfmake": "2.6.0",
    "pdfmake": "0.3.14",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "20.2.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@oxlint/plugins": "1.94.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@tesseract.js-data/eng": "1.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/chrome": "0.3.7",
    "@types/html-to-pdfmake": "2.4.5",
    "@types/node": "26.6.6",
    "@types/pdfmake": "0.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.1",
    "oxc-resolver": "11.24.2",
    "oxc-transform-react": "0.158.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "pdfjs-dist": "6.5.438",
    "tailwindcss": "4.3.5",
    "tesseract.js-core": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "5.1.0"
  }
}
