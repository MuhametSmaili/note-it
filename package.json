{
  "name": "note-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "webpack --watch --progress --config ./webpack/webpack.dev.js",
    "build": "NODE_ENV=production webpack --progress --config ./webpack/webpack.prod.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "update:deps": "npx npm-check-updates --interactive --format group",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,js,cjs,mjs}": [
      "oxlint --deny-warnings --report-unused-disable-directives --no-error-on-unmatched-pattern",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,svg}": "prettier --write"
  },
  "dependencies": {
    "@tiptap/core": "2.27.3",
    "@tiptap/extension-image": "2.27.3",
    "@tiptap/extension-link": "2.27.3",
    "@tiptap/extension-underline": "2.27.3",
    "@tiptap/pm": "2.27.3",
    "@tiptap/react": "2.27.3",
    "@tiptap/starter-kit": "2.27.3",
    "clsx": "2.1.1",
    "html-to-pdfmake": "2.6.0",
    "lodash.debounce": "4.0.8",
    "pdfmake": "0.2.23",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "14.4.1",
    "tesseract.js": "^4.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@svgr/webpack": "8.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/chrome": "0.0.332",
    "@types/html-to-pdfmake": "2.4.5",
    "@types/lodash.debounce": "4.0.9",
    "@types/node": "24.19.2",
    "@types/pdfmake": "0.2.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "autoprefixer": "10.6.2",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "html-webpack-plugin": "5.6.8",
    "husky": "9.1.7",
    "jsdom": "31.0.0",
    "lint-staged": "17.6.0",
    "oxlint": "1.93.0",
    "postcss-loader": "8.2.1",
    "prettier": "3.10.1",
    "style-loader": "4.0.0",
    "tailwindcss": "3.4.19",
    "ts-loader": "9.6.2",
    "typescript": "^5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1"
  }
}
