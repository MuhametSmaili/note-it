{
  "name": "note-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "webpack --watch --progress --config ./webpack/webpack.dev.js",
    "build": "NODE_ENV=production webpack --progress --config ./webpack/webpack.prod.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "update:deps": "npx npm-check-updates --interactive --format group",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "oxlint --deny-warnings --report-unused-disable-directives --no-error-on-unmatched-pattern",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,svg}": "prettier --write"
  },
  "dependencies": {
    "@tiptap/extension-image": "2.8.0",
    "@tiptap/extension-link": "2.8.0",
    "@tiptap/extension-underline": "2.8.0",
    "@tiptap/pm": "2.8.0",
    "@tiptap/react": "2.8.0",
    "@tiptap/starter-kit": "2.8.0",
    "clsx": "2.1.1",
    "html-to-pdfmake": "2.5.13",
    "lodash.debounce": "4.0.8",
    "pdfmake": "0.2.14",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-dropzone": "14.2.3",
    "tesseract.js": "^4.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@svgr/webpack": "8.1.0",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.1",
    "@types/chrome": "0.0.277",
    "@types/html-to-pdfmake": "2.4.4",
    "@types/lodash.debounce": "4.0.9",
    "@types/node": "22.7.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@types/styled-components": "5.1.34",
    "@vitejs/plugin-react": "4.3.2",
    "autoprefixer": "10.4.20",
    "clean-webpack-plugin": "4.0.0",
    "copy-webpack-plugin": "12.0.2",
    "css-loader": "7.1.2",
    "global-jsdom": "25.0.0",
    "html-webpack-plugin": "5.6.0",
    "husky": "9.1.6",
    "jsdom": "25.0.1",
    "lint-staged": "15.2.10",
    "oxlint": "1.90.0",
    "postcss-loader": "8.1.1",
    "prettier": "3.3.3",
    "style-loader": "4.0.0",
    "tailwindcss": "3.4.13",
    "ts-loader": "9.5.1",
    "typescript": "^5.6.3",
    "vitest": "2.1.2",
    "webpack": "5.95.0",
    "webpack-cli": "5.1.4"
  }
}
