{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "vitest", "import"],
  "jsPlugins": ["./scripts/architecture-plugin.mts"],
  "options": { "typeAware": true },
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "browser": true,
    "webextensions": true,
    "node": false
  },
  "ignorePatterns": ["node_modules/**", "build/**", "coverage/**", ".vitest/**", ".playwright/**"],
  "rules": {
    "eqeqeq": ["error", "always"],
    "no-debugger": "error",
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "prefer-const": "error",
    "unicorn/filename-case": ["error", { "case": "kebabCase", "multipleFileExtensions": false }],
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off",
    "import/no-named-as-default": "off",
    "import/no-cycle": "error",
    "architecture/dependencies": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/error-boundaries": "error",
    "react/globals": "error",
    "react/immutability": "error",
    "react/incompatible-library": "error",
    "react/preserve-manual-memoization": "error",
    "react/purity": "error",
    "react/refs": "error",
    "react/set-state-in-effect": "error",
    "react/set-state-in-render": "error",
    "react/static-components": "error",
    "react/unsupported-syntax": "error",
    "react/use-memo": "error",
    "react/void-use-memo": "error",
    "react/button-has-type": "error",
    "typescript/no-floating-promises": ["error", { "ignoreVoid": false }],
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error"
  },
  "overrides": [
    {
      "files": ["src/**"],
      "excludeFiles": [
        "src/platform/**",
        "src/modules/database/internal/indexed-db.ts",
        "**/__tests__/**",
        "**/*.test.*"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "checkGlobalObject": true,
            "globals": [
              {
                "name": "chrome",
                "message": "Use the browser platform interface."
              },
              {
                "name": "browser",
                "message": "Use the browser platform interface."
              },
              {
                "name": "indexedDB",
                "message": "Use the database module's public interface."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/modules/**"],
      "excludeFiles": [
        "**/__tests__/**",
        "**/*.test.*",
        "src/modules/notes/internal/web-extension.ts",
        "src/modules/database/internal/indexed-db.ts",
        "src/modules/notes/internal/indexed-db-repository.ts",
        "src/modules/notes/internal/database-schema.ts",
        "src/modules/notes/internal/database-storage.ts",
        "src/modules/notes/internal/database-migration.ts"
      ],
      "rules": {
        "architecture/dependencies": ["error", "domain"],
        "no-restricted-globals": [
          "error",
          {
            "checkGlobalObject": true,
            "globals": [
              "chrome",
              "browser",
              "window",
              "document",
              "navigator",
              "globalThis",
              "self",
              "fetch",
              "XMLHttpRequest",
              "WebSocket",
              "EventSource",
              "Worker",
              "SharedWorker",
              "localStorage",
              "sessionStorage",
              "indexedDB",
              "caches",
              "crypto",
              "Date",
              "performance",
              "setTimeout",
              "setInterval",
              "requestAnimationFrame"
            ]
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random",
            "message": "Receive randomness through an adapter."
          }
        ]
      }
    },
    {
      "files": ["**/*.test.{ts,tsx,mts}"],
      "rules": {
        "typescript/unbound-method": "off",
        "typescript/no-unsafe-assignment": "off",
        "vitest/expect-expect": "error",
        "vitest/no-commented-out-tests": "error",
        "vitest/no-conditional-expect": "error",
        "vitest/require-mock-type-parameters": "error",
        "vitest/valid-expect": "error",
        "vitest/valid-expect-in-promise": "error"
      }
    },
    {
      "files": ["*.config.{js,ts,mts}", "scripts/**/*.mts"],
      "env": { "node": true, "browser": false, "webextensions": false }
    }
  ]
}
